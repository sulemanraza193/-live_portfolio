# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace <user>, <password>, and <cluster> with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# CORS / Client Settings
CLIENT_URL=http://localhost:5173

# Authentication Secrets
# Ensure JWT_SECRET is set to a strong 32+ character random string in production
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Initial Admin Seeding Script
# Used only by `npm run seed:admin` — not read during standard runtime
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_this_password

# External Integrations
GITHUB_USERNAME=sulemanraza193
# Optional: Fine-grained Personal Access Token (PAT) with public/read-only access
# Recommended to prevent 429 Rate Limit errors when fetching public repos
GITHUB_TOKEN=
